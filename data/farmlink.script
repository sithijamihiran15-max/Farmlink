CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE USERS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,ROLE VARCHAR(12) NOT NULL,FIRST_NAME VARCHAR(90) NOT NULL,LAST_NAME VARCHAR(90) NOT NULL,NIC VARCHAR(40) NOT NULL,EMAIL VARCHAR(150),PHONE VARCHAR(30) NOT NULL,DISTRICT VARCHAR(80) NOT NULL,PROVINCE VARCHAR(80) NOT NULL,ADDRESS VARCHAR(255) NOT NULL,PASSWORD_HASH VARCHAR(255) NOT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,CONSTRAINT SYS_CT_47 UNIQUE(NIC))
CREATE MEMORY TABLE HARVESTS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,FARMER_ID INTEGER NOT NULL,TITLE VARCHAR(100) NOT NULL,CATEGORY VARCHAR(60) NOT NULL,DISTRICT VARCHAR(80) NOT NULL,PRICE DOUBLE NOT NULL,QUANTITY DOUBLE NOT NULL,UNIT VARCHAR(30) NOT NULL,STATUS VARCHAR(15) NOT NULL,DESCRIPTION VARCHAR(3000) NOT NULL,IMAGE LONGVARCHAR,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,CONSTRAINT SYS_FK_51 FOREIGN KEY(FARMER_ID) REFERENCES USERS(ID))
CREATE MEMORY TABLE INQUIRIES(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,HARVEST_ID INTEGER NOT NULL,BUYER_ID INTEGER NOT NULL,FARMER_ID INTEGER NOT NULL,QUANTITY DOUBLE NOT NULL,STATUS VARCHAR(15) NOT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,CONSTRAINT SYS_FK_56 FOREIGN KEY(HARVEST_ID) REFERENCES HARVESTS(ID),CONSTRAINT SYS_FK_57 FOREIGN KEY(BUYER_ID) REFERENCES USERS(ID),CONSTRAINT SYS_FK_58 FOREIGN KEY(FARMER_ID) REFERENCES USERS(ID))
CREATE MEMORY TABLE MESSAGES(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,INQUIRY_ID INTEGER NOT NULL,SENDER_ID INTEGER NOT NULL,BODY VARCHAR(2000) NOT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,CONSTRAINT SYS_FK_67 FOREIGN KEY(INQUIRY_ID) REFERENCES INQUIRIES(ID),CONSTRAINT SYS_FK_68 FOREIGN KEY(SENDER_ID) REFERENCES USERS(ID))
CREATE MEMORY TABLE SAVED(BUYER_ID INTEGER NOT NULL,HARVEST_ID INTEGER NOT NULL,PRIMARY KEY(BUYER_ID,HARVEST_ID),CONSTRAINT SYS_FK_75 FOREIGN KEY(BUYER_ID) REFERENCES USERS(ID),CONSTRAINT SYS_FK_76 FOREIGN KEY(HARVEST_ID) REFERENCES HARVESTS(ID))
CREATE MEMORY TABLE SESSIONS(TOKEN_HASH VARCHAR(100) NOT NULL PRIMARY KEY,USER_ID INTEGER NOT NULL,EXPIRES_AT TIMESTAMP NOT NULL,CONSTRAINT SYS_FK_83 FOREIGN KEY(USER_ID) REFERENCES USERS(ID))
ALTER TABLE USERS ALTER COLUMN ID RESTART WITH 0
ALTER TABLE HARVESTS ALTER COLUMN ID RESTART WITH 0
ALTER TABLE INQUIRIES ALTER COLUMN ID RESTART WITH 0
ALTER TABLE MESSAGES ALTER COLUMN ID RESTART WITH 0
CREATE USER SA PASSWORD ""
GRANT DBA TO SA
SET WRITE_DELAY 10
